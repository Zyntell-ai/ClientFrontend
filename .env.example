# ClientFrontend environment — copy to .env.local and fill in. Never commit real values.

# Backend API base URL
VITE_API_URL=http://localhost:3001

# Mapbox PUBLIC access token (pk.*) for the business-location map and address search (Phase 5).
# Use a token restricted to your client domains (e.g. https://client.zyntell.in, http://localhost:5173)
# in the Mapbox account. Without it the map is hidden and only address fields + "use my current
# location" are available.
VITE_MAPBOX_ACCESS_TOKEN=
